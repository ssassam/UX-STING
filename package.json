{
  "name": "ux-sting-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "ux-sting — an accessible, themeable, tree-shakeable React UI system.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "build": "turbo run build --filter=./packages/*",
    "build:all": "turbo run build",
    "dev": "turbo run dev --parallel",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:a11y": "vitest run --project react -t a11y",
    "size": "node scripts/bundle-size.ts",
    "registry": "node scripts/build-registry.ts",
    "readmes": "node scripts/extract-api.ts && node scripts/generate-readmes.ts",
    "icons": "node scripts/generate-icons.mjs && prettier --write --log-level warn packages/icons/src",
    "check": "pnpm build && pnpm typecheck && pnpm lint && pnpm test",
    "api": "node scripts/extract-api.ts",
    "ux-audit": "node scripts/ux-audit.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "axe-core": "^4.11.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^17.0.0",
    "jsdom": "^30.0.0",
    "lucide": "^1.0.0",
    "prettier": "^3.6.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "turbo": "^2.5.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
