{
  "name": "@ux-sting/utils",
  "version": "0.5.0",
  "description": "Framework-agnostic utilities for ux-sting: class merging, variants, keyboard, focus, responsive, formatting and theme helpers.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ssassam/UX-STING.git",
    "directory": "packages/utils"
  },
  "homepage": "https://github.com/ssassam/UX-STING#readme",
  "bugs": "https://github.com/ssassam/UX-STING/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "tailwind-merge": "^3.3.0"
  },
  "peerDependencies": {},
  "devDependencies": {
    "typescript": "~6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
