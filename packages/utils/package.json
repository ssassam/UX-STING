{
  "name": "@unified-ui/utils",
  "version": "0.1.0",
  "description": "Framework-agnostic utilities for unified-ui: class merging, variants, keyboard, focus, responsive, formatting and theme helpers.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "tailwind-merge": "^3.3.0"
  },
  "peerDependencies": {},
  "devDependencies": {
    "typescript": "~6.0.3"
  }
}
