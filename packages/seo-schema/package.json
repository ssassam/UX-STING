{
  "name": "@ux-sting/seo-schema",
  "version": "0.8.0",
  "description": "Typed schema.org JSON-LD builders, safe serialization and validation that separates schema.org validity from Google rich-result eligibility. Zero dependencies, framework-agnostic.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ssassam/UX-STING.git",
    "directory": "packages/seo-schema"
  },
  "homepage": "https://github.com/ssassam/UX-STING#readme",
  "bugs": "https://github.com/ssassam/UX-STING/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "seo",
    "json-ld",
    "schema.org",
    "structured-data",
    "rich-results"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "dependencies": {},
  "peerDependencies": {},
  "devDependencies": {
    "typescript": "~7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
