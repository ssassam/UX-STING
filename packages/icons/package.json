{
  "name": "@ux-sting/icons",
  "version": "0.8.0",
  "description": "Tree-shakeable SVG icons for ux-sting (icon data from Lucide, ISC), with an optional animated layer: intent-driven hover/mount/loop motions that are token-aware and reduced-motion safe.",
  "license": "MIT AND ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ssassam/UX-STING.git",
    "directory": "packages/icons"
  },
  "homepage": "https://github.com/ssassam/UX-STING#readme",
  "bugs": "https://github.com/ssassam/UX-STING/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dynamic": {
      "types": "./dist/icon.d.ts",
      "import": "./dist/icon.js"
    },
    "./animated": {
      "types": "./dist/animated.d.ts",
      "import": "./dist/animated.js"
    },
    "./animated.css": "./dist/icon-motion.css",
    "./icons/*": {
      "types": "./dist/icons/*.d.ts",
      "import": "./dist/icons/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE-lucide"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-css.mjs",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "typescript": "~7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
