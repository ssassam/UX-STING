{
  "name": "@ux-sting/themes",
  "version": "0.13.1",
  "description": "Theme engine and presets for ux-sting (default, neutral, modern, compact, soft, high-contrast, plus Material, Fluent, Carbon, Polaris, Apple, Base Web and Stripe styles).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ssassam/UX-STING.git",
    "directory": "packages/themes"
  },
  "homepage": "https://github.com/ssassam/UX-STING#readme",
  "bugs": "https://github.com/ssassam/UX-STING/issues",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./themes.css": "./dist/themes.css",
    "./*.css": "./dist/*.css",
    "./designs/*": "./designs/*"
  },
  "files": [
    "dist",
    "designs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-css.mjs && node scripts/build-designs.mjs",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "designs": "node scripts/build-designs.mjs"
  },
  "dependencies": {
    "@ux-sting/tokens": "workspace:^",
    "yaml": "^2.8.0"
  },
  "peerDependencies": {},
  "devDependencies": {
    "typescript": "~6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
