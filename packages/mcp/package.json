{
  "name": "@ux-sting/mcp",
  "version": "0.6.2",
  "description": "UX-STING design tools exposed through MCP stdio.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../cli/scripts/add-shebang.mjs dist/cli.js",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.6",
    "@ux-sting/themes": "workspace:^",
    "@ux-sting/tokens": "workspace:^",
    "@ux-sting/design-dna": "workspace:^",
    "@ux-sting/extract": "workspace:^",
    "@ux-sting/qa": "workspace:^",
    "@ux-sting/universal": "workspace:^",
    "@ux-sting/vision": "workspace:^"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "@types/node": "^24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.16"
  },
  "bin": {
    "ux-sting-mcp": "./dist/cli.js"
  }
}
