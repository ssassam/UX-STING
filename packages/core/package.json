{
  "name": "@ux-sting/core",
  "version": "0.1.0",
  "description": "Framework-agnostic entry point for ux-sting: tokens, theme engine and utilities in one import.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "@ux-sting/themes": "workspace:^",
    "@ux-sting/tokens": "workspace:^",
    "@ux-sting/utils": "workspace:^"
  },
  "peerDependencies": {},
  "devDependencies": {
    "typescript": "~7.0.2"
  }
}
