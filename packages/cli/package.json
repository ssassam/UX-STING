{
  "name": "ux-sting",
  "version": "0.7.0",
  "description": "CLI for ux-sting: copy accessible, themeable React components into your project.",
  "license": "MIT",
  "author": {
    "name": "Issam El Bani (VELTEIN)",
    "url": "https://veltein.com"
  },
  "funding": {
    "type": "buymeacoffee",
    "url": "https://buymeacoffee.com/veltein"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ssassam/UX-STING.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/ssassam/UX-STING#readme",
  "bugs": "https://github.com/ssassam/UX-STING/issues",
  "type": "module",
  "bin": {
    "ux-sting": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "registry.json",
    "README.md",
    "scripts/check-readme.mjs"
  ],
  "scripts": {
    "prepack": "node ./scripts/check-readme.mjs",
    "build": "node ../../scripts/build-registry.ts && tsc -p tsconfig.build.json && node ./scripts/add-shebang.mjs",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "engines": {
    "node": ">=20.9"
  },
  "devDependencies": {
    "@ux-sting/images": "workspace:^",
    "@ux-sting/extract": "workspace:^",
    "@ux-sting/qa": "workspace:^",
    "@types/node": "^24.0.0",
    "typescript": "~6.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@ux-sting/qa": ">=0.1.0",
    "@ux-sting/extract": ">=0.1.0",
    "@ux-sting/images": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "@ux-sting/qa": {
      "optional": true
    },
    "@ux-sting/extract": {
      "optional": true
    },
    "@ux-sting/images": {
      "optional": true
    }
  }
}
