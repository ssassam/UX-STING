{
  "name": "@ux-sting/qa",
  "version": "0.2.0",
  "description": "Browser QA for agents: screenshots at 375/768/1440, axe, contrast, layout checks (overflow, margins, orphans, empty stretches, first-screen title), console errors and LCP/CLS, with a short markdown report and ranked top-3 fixes.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ux-sting-qa": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "accessibility",
    "axe",
    "playwright",
    "visual-qa",
    "core-web-vitals",
    "ai-agents"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../cli/scripts/add-shebang.mjs dist/cli.js",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@ux-sting/design-dna": "workspace:^",
    "axe-core": "^4.11.0",
    "playwright-core": "1.63.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ssassam/UX-STING.git",
    "directory": "packages/qa"
  },
  "homepage": "https://github.com/ssassam/UX-STING#readme",
  "bugs": "https://github.com/ssassam/UX-STING/issues",
  "publishConfig": {
    "access": "public"
  }
}
