{
  "name": "@ux-sting/primitives",
  "version": "0.1.0",
  "description": "Headless, accessible building blocks for ux-sting: Slot, VisuallyHidden, Portal, roving focus, calendar math and collections.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "@ux-sting/hooks": "workspace:^",
    "@ux-sting/utils": "workspace:^"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "typescript": "~7.0.2"
  }
}
