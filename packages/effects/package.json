{
  "name": "@ux-sting/effects",
  "version": "0.6.2",
  "description": "Accessible decorative React effects with CSS motion and cleanup.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./effects.css": "./dist/effects.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-css.mjs",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "~6.0.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.16"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0"
  }
}
