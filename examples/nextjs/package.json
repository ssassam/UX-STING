{
  "name": "@ux-sting/example-nextjs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Next.js starter whose components were copied with `npx ux-sting init && npx ux-sting add \u2026`.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "ui:add": "node ../../packages/cli/dist/index.js add --no-install"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-direction": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@ux-sting/hooks": "workspace:^",
    "@ux-sting/icons": "workspace:^",
    "@ux-sting/primitives": "workspace:^",
    "@ux-sting/themes": "workspace:^",
    "@ux-sting/tokens": "workspace:^",
    "@ux-sting/utils": "workspace:^",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2"
  }
