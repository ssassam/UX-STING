{
  "name": "@unified-ui/example-nextjs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Next.js starter whose components were copied with `npx unified-ui init && npx unified-ui add \u2026`.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "ui:add": "node ../../packages/cli/dist/index.js add --no-install"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-direction": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@unified-ui/hooks": "workspace:^",
    "@unified-ui/icons": "workspace:^",
    "@unified-ui/primitives": "workspace:^",
    "@unified-ui/themes": "workspace:^",
    "@unified-ui/tokens": "workspace:^",
    "@unified-ui/utils": "workspace:^",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3"
  }
}
